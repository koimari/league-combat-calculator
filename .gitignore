# Local environment files (secrets)
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# lolstaticdata download cache
vendor/lolstaticdata/__cache__/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Claude Code plans (temporary)
.claude/plans/

# Local dev-server logs
.app-server.stdout.log
.app-server.stderr.log

# P0b database backups (scripts/backup_db.py output)
backups/

# Local browser-verification artifacts
.playwright-cli/
output/
.vercel
# data/bin: decomposed game binaries. The per-champion dumps are TRACKED
# (runtime constants root in them; ~11 MB, one refresh per patch). The item
# and map dumps stay ignored (regenerable, and nothing at runtime reads them).
data/bin/*
!data/bin/characters
data/bin/characters/*
!data/bin/characters/*.bin.json
data/wiki-raw/
# Wiki revision index the reviewed-packet gate reads (plus its staging file).
# Current wiki state, so it is rebuilt per patch day, never committed:
# scripts/decompose_wiki.py --wiki-db
data/wiki/league-wiki.sqlite3*
data/atoms/*.atoms.json
docs/receipts/champions/*.json
docs/receipts/items/*.json

# P3 patch-regression game-file cache (cdtb raw exports)
data/gamefiles/

# cdtb patcher storage (recreated under data/gamefiles/.cdtb)
cdn/

# Closed generated-modules lane: build_reviewed_modules.py emits regenerable
# stubs here on patch-day runs, but the roster is registry-only (no generated/
# lane, see .agents/skills/add-champion). The packet asset is static/reviewed-packets.json.
src/calculator/champions/generated/
