{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "League champion behavior atom (6-family bridge taxonomy)",
 "description": "A per-champion atom list. Every champion mechanic is a composition of these atoms. Families follow the LCC bridge taxonomy used by the classifier and the certified corpus.",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "atom_id",
   "family",
   "behavior",
   "trigger",
   "target_policy",
   "parameters",
   "provenance"
  ],
  "properties": {
   "atom_id": {
    "type": "string",
    "description": "stable id, e.g. 'damage.basic-attack'"
   },
   "family": {
    "type": "string",
    "enum": [
     "crowd-control-mobility",
     "damage",
     "heal-shield",
     "interaction",
     "stack-transform-summon-resource",
     "vision-economy"
    ]
   },
   "behavior": {
    "type": "string"
   },
   "trigger": {
    "type": "string"
   },
   "target_policy": {
    "type": "string"
   },
   "parameters": {
    "type": "object",
    "properties": {
     "cooldown_rank1": {
      "type": [
       "number",
       "null"
      ]
     },
     "cooldown_rank_max": {
      "type": [
       "number",
       "null"
      ]
     },
     "range": {
      "type": [
       "number",
       "null"
      ]
     },
     "damage_type": {
      "type": [
       "string",
       "null"
      ]
     },
     "affects_type_flags": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   },
   "relations": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "provenance": {
    "type": "object",
    "required": [
     "binary"
    ],
    "properties": {
     "wiki": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "binary": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "evidence": {
      "type": "string"
     }
    }
   }
  }
 }
}