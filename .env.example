# Scryglass closed-beta deployment environment.
# Copy to .env for local runs (never commit .env), or set these as Vercel
# Production environment variables.  Every variable below is optional unless
# its description says REQUIRED.

# --- Auth gate -------------------------------------------------------------
# Set to 1/true/yes/on to require login for every page and API.  REQUIRED for
# the closed beta; leave unset locally.
SCRYGLASS_AUTH_REQUIRED=0

# Long random secret used to sign the session cookie (HMAC-SHA256). REQUIRED
# when SCRYGLASS_AUTH_REQUIRED=1.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SCRYGLASS_AUTH_SECRET=

# JSON object mapping research-account names to scrypt$ password hashes.
# REQUIRED when SCRYGLASS_AUTH_REQUIRED=1.  Generate a hash with the Python
# used by the test suite, e.g.:
#   python -c "import base64,hashlib; s=b'salt-bytes'; d=hashlib.scrypt(b'password',salt=s,n=16384,r=8,p=1); e=lambda v:base64.urlsafe_b64encode(v).rstrip(b'=').decode(); print(f'scrypt$16384$8$1${e(s)}${e(d)}')"
# Example value:
#   {"BetaResearcher":"scrypt$16384$8$1$...$..."}
SCRYGLASS_AUTH_USERS=

# --- Invite gating (closed-beta layer) -------------------------------------
# Comma-separated invite codes.  When set together with SCRYGLASS_AUTH_REQUIRED=1
# the landing page asks for an invite code + research-account password, and the
# validated code is recorded in the session.  Unset or empty = password-only.
# Rotate codes between beta batches by changing this variable and redeploying.
SCRYGLASS_INVITE_CODES=

# --- Managed Postgres ------------------------------------------------------
# SQLAlchemy URL of the managed database.  Builds, share links, validation
# feedback and staleness state live here.  postgres:// and postgresql:// are
# normalized to the psycopg3 driver automatically.  With no value, a local
# SQLite file under the system temp dir is used for development only.
#   Neon:      postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase:  postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#   RDS:       postgresql://user:password@db-instance.region.rds.amazonaws.com:5432/lcc
DATABASE_URL=

# --- Managed Redis (result cache) ------------------------------------------
# redis:// URL of the managed Redis used for calculation-result caching.
# When set, the result cache uses Redis (get/set with TTL, hit/miss counters);
# otherwise it falls back to the CachedResult table in DATABASE_URL's database.
#   Upstash:   rediss://default:password@xxx.upstash.io:6379
REDIS_URL=

# --- Tuning -----------------------------------------------------------------
# TTL in seconds for cached calculation results (default 86400 = 24h).
# Data updates invalidate the cache explicitly.
CACHE_TTL_SECONDS=86400

# Gunicorn worker count / port (Docker and PaaS hosts; Vercel ignores these).
WEB_CONCURRENCY=2
PORT=8000

# --- Local development only --------------------------------------------------
# 1 enables the dev-only /api/update-data and /api/staleness/regenerate
# endpoints (loopback + dev cookie guarded).  Never set on a deployment.
LOL_CALC_DEV=0
# Set automatically by Render/Fly; disables dev mode on those hosts.
RENDER=false
